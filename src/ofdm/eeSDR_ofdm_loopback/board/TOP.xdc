create_clock -name ad9361_data_clk -period 12.500 [get_ports data_clk_p]
create_clock -name board_50m -period 20.000 [get_ports i_clk_50M]

# Independent board oscillator: only the first stage of the existing ASYNC_REG
# LED status synchronizers is asynchronous. Keep stage 1 -> stage 2 timed.
# These bits are display-only levels, never packet/control handshakes.
set_false_path -to [get_pins -hier -filter {NAME =~ *r_status_sync_1_reg*/D}]

