<launch>
    <!-- 是否打开rviz || Whether to open rviz -->
    <arg name="use_rviz" default="false"/>
    <!-- 地图名 || Map name  my_map-->
    <arg name="map" default="/maps/x3plus_map"/>
    <!-- Accept a bare name, /maps/name, .yaml, or the old VM workspace path. -->
    <arg name="map_base" default="$(eval ('/maps/' + arg('map').replace('.yaml', '')) if '/' not in arg('map') else arg('map').replace('~/yahboomcar_ws/src/yahboomcar_nav/maps', '/maps').replace('/root/yahboomcar_ws/src/yahboomcar_nav/maps', '/maps').replace('/home/amd/yahboomcar_ws/src/yahboomcar_nav/maps', '/maps').replace('/home/jetson/yahboomcar_ws/src/yahboomcar_nav/maps', '/maps').replace('/home/pi/yahboomcar_ws/src/yahboomcar_nav/maps', '/maps'))"/>
    <arg name="map_file" default="$(eval arg('map_base') if arg('map_base').endswith('.yaml') else arg('map_base') + '.yaml')"/>
    <!-- Explicit opt-in; ordinary navigation never starts a patrol. -->
    <arg name="enable_multipoint" default="false"/>
    <!-- Localization quality is advisory after initial confirmation. -->
    <arg name="quality_interlock" default="false"/>
    <node name='send_mark' pkg="yahboomcar_nav" type="send_mark.py" if="$(arg enable_multipoint)"/>
    <node name="navigation_guard" pkg="yahboomcar_nav" type="navigation_guard.py"
          required="true" output="screen">
        <param name="quality_interlock" value="$(arg quality_interlock)"/>
    </node>
    <!-- 加载地图 || Load map -->
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)"/>
    <!-- AMCL自适应蒙特卡洛定位 -->
    <include file="$(find yahboomcar_nav)/launch/library/amcl.launch"/>
    <!-- 手机APP节点 -->
    <!-- 导航核心组件move_base -->
    <include file="$(find yahboomcar_nav)/launch/library/move_base.launch">
        <arg name="guarded" value="true"/>
    </include>
    <!-- RVIZ -->
    <include file="$(find yahboomcar_nav)/launch/view_navigate.launch" if="$(arg use_rviz)"/>
</launch>

