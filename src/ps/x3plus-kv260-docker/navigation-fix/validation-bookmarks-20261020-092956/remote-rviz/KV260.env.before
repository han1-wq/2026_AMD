# Copy to KV260.env and source it before using the helper scripts.
# Use stable udev aliases or /dev/serial/by-id paths; never use /dev/ttyUSB0 or /dev/ttyUSB1 directly.
export IMAGE=x3plus:melodic-arm64
export ROS_MASTER_URI=http://127.0.0.1:11311
export ROS_HOSTNAME=127.0.0.1
export ROBOT_TYPE=X3plus
export ROBOT_SERIAL=/dev/myserial
export LIDAR_SERIAL=/dev/ydlidar
export LIDAR_BAUDRATE=512000
export LIDAR_DEVICE_TYPE=0
export LIDAR_TYPE=0
export MAP_DIR=/home/ubuntu/x3plus-maps

# USB identity is checked independently of udev alias names.
export ROBOT_USB_VID=1a86
export ROBOT_USB_PID=7523
export ROBOT_USB_INTERFACE=00
# This CH340 has no serial number: bind to the current physical USB port.
# After moving its cable, inspect launcher_core.py output and update this value.
export ROBOT_USB_LOCATION=1-1.4
export LIDAR_USB_VID=10c4
export LIDAR_USB_PID=ea60
export LIDAR_USB_INTERFACE=00
export LIDAR_USB_SERIAL=0001
