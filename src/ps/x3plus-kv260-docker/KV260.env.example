# Copy to KV260.env and source it before using the helper scripts.
# Use /dev/serial/by-id/... whenever the KV260 exposes stable USB names.
export IMAGE=x3plus:melodic-arm64
export ROS_MASTER_URI=http://127.0.0.1:11311
export ROS_HOSTNAME=127.0.0.1
export ROBOT_TYPE=X3plus
export ROBOT_SERIAL=/dev/myserial
export LIDAR_SERIAL=/dev/ydlidar
export LIDAR_BAUDRATE=512000
export LIDAR_DEVICE_TYPE=0
export LIDAR_TYPE=0
export MAP_DIR=/opt/x3plus-maps