[Unit]
Description=SO101 KV260 teleoperation dashboard
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/lerobot-deploy/teleop-ui
ExecStart=/usr/bin/python3 -B /home/ubuntu/lerobot-deploy/teleop-ui/server.py --role board --bind 0.0.0.0 --port 8089 --public-host 192.168.43.182:8089
Restart=on-failure
RestartSec=3
KillMode=process
UMask=0077

[Install]
WantedBy=default.target