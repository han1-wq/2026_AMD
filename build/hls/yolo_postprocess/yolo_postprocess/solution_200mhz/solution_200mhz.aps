<AutoPilot:solution xmlns:AutoPilot="com.autoesl.autopilot.solution">
    <config>
        <config_interface m_axi_latency="0" m_axi_addr64="1"/>
        <config_export format="ip_catalog" library="vision" rtl="verilog" vendor="local" version="1.0"/>
    </config>
    <Simulation argv="--smoke">
        <SimFlow name="cosim" setup="false" dumpTrace="none" optimizeCompile="false" ldflags="" mflags="" compiledLibrary="" toolName="xsim">
            <Rtl name="systemc" active="false"/>
            <Rtl name="verilog" active="true"/>
            <Rtl name="vhdl" active="false"/>
        </SimFlow>
    </Simulation>
    <ExportDesign askAgain="true" evaluate="false" rtl="verilog" formatName="ip_catalog">
        <Format formatName="ip_catalog" description="" vendor="local" library="vision" ipname="yolo_postprocess" version="1.0" display_name="" taxonomy=""/>
    </ExportDesign>
    <name>
        <value string="solution_200mhz"/>
    </name>
    <project>
        <value string="yolo_postprocess"/>
    </project>
    <flowTarget value="vivado"/>
    <targetInfo>
        <TargetInfo value="xck26:-sfvc784:-2LV-c"/>
    </targetInfo>
    <libraryList>
        <library value="xilinx/zynquplus/zynquplus" name="DefaultPlatform"/>
    </libraryList>
    <clockList>
        <clock default="false" name="default" uncertainty="0.625" period="5"/>
    </clockList>
</AutoPilot:solution>

